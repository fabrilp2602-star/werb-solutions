# Required for the server-side admin session. Never commit real values.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD_HASH=scrypt:generate-with-node-script
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional consent-gated advertising analytics.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The current local JSON adapter is for development only. Configure a managed
# database adapter before production campaigns; Vercel filesystem is ephemeral.
